{
    "name": "nuelcyoung/tenantable",
    "description": "A flexible multitenancy package for CodeIgniter 4. Identify tenants by subdomain, custom domain, path, or request header, and isolate them with row-level scoping, table prefixes, or a dedicated database per tenant.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter4",
        "multitenancy",
        "multi-tenant",
        "tenant",
        "saas",
        "subdomain",
        "database",
        "isolation"
    ],
    "homepage": "https://github.com/nuelcyoung/tenantable",
    "support": {
        "issues": "https://github.com/nuelcyoung/tenantable/issues",
        "source": "https://github.com/nuelcyoung/tenantable"
    },
    "authors": [
        {
            "name": "Nuel Young Chukwunalu",
            "email": "nuelmega@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-pgsql": "Required when using PostgreSQL.",
        "codeigniter4/queue": "Required for tenant-aware queued jobs (tenant_push(), TenantableJob)."
    },
    "autoload": {
        "psr-4": {
            "nuelcyoung\\tenantable\\": "src/"
        },
        "classmap": [
            "src/Database/Migrations/"
        ],
        "files": [
            "src/Helpers/tenantable_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "nuelcyoung\\tenantable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "codeigniter4": {
            "commands": [
                "nuelcyoung\\tenantable\\Commands\\TenantsInstall",
                "nuelcyoung\\tenantable\\Commands\\TenantsList",
                "nuelcyoung\\tenantable\\Commands\\TenantsRun",
                "nuelcyoung\\tenantable\\Commands\\TenantsSetup",
                "nuelcyoung\\tenantable\\Commands\\TenantsCreate",
                "nuelcyoung\\tenantable\\Commands\\TenantsDoctor",
                "nuelcyoung\\tenantable\\Commands\\TenantsMakeModel",
                "nuelcyoung\\tenantable\\Commands\\TenantsMakeMigration"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
